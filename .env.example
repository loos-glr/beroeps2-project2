# Voorbeeldconfiguratie. Kopieer naar .env en pas de waarden aan:  cp .env.example .env
# Het echte .env-bestand staat in .gitignore en mag NOOIT in Git komen.

APP_ENV=local
APP_PORT=8000

# Database (lokaal via DBngin: kijk bij je MySQL-service voor de poort)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beroeps2
DB_USER=root
DB_PASS=
